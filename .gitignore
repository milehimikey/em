node_modules/
dist/
*.log
# rendered output
*.svg
*.png
# keep canonical reference renders for the examples (SVG is the default format)
!examples/*.svg
!examples/*.png

# em catalog's default --out directory (index.html + per-slice pages aren't
# covered by the *.svg/*.png rules above, since it's a whole site, not a
# single rendered image)
catalog/

# Local Claude Code permission config — never committed, never published
.claude/settings.local.json

# Private working notes / engagements — kept in the private project-notes vault,
# never in this public repo
internal/
