node_modules/
dist/
*.log
# rendered output
*.svg
*.png
# keep canonical reference renders for the examples (SVG is the default format) — the flat
# example files, and examples/order-fulfillment/ (a full project directory, not a bare
# model file), including its own slices/*.svg per-slice renders.
!examples/*.svg
!examples/*.png
!examples/order-fulfillment/*.svg
!examples/order-fulfillment/*.png
!examples/order-fulfillment/slices/*.svg

# em catalog's default --out directory (index.html + per-slice pages aren't
# covered by the *.svg/*.png rules above, since it's a whole site, not a
# single rendered image). Anchored to the repo root — an unanchored `catalog/`
# also matches src/catalog/ at any depth, silently hiding new files there from
# `git status` (already-tracked files are unaffected, which is why this went
# unnoticed until MIL-91 added a new file in src/catalog/).
/catalog/

# Local Claude Code permission config — never committed, never published
.claude/settings.local.json

# Private working notes / engagements — kept in the private project-notes vault,
# never in this public repo
internal/
.DS_Store
